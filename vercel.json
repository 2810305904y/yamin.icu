{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/fail",
      "destination": "/"
    },
    {
      "source": "/styles.css",
      "destination": "/v1/styles.css"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/v1/scripts/:path*"
    },
    {
      "source": "/content/:path*",
      "destination": "/v1/content/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/site-data-backup",
      "schedule": "0 20 * * 0"
    }
  ]
}
