{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "/v1/styles.css"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/v1/scripts/:path*"
    },
    {
      "source": "/content/:path*",
      "destination": "/v1/content/:path*"
    }
  ]
}
